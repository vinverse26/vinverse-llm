# Which model provider to route to (only 'anthropic' is implemented today)
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5

# Where the MCP server is running (note the /mcp path suffix — depends on
# your installed mcp SDK version's default route, verify if this 404s)
MCP_SERVER_URL=http://localhost:8001/mcp
